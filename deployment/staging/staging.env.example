# Copy to /etc/forgestudio/staging.env with mode 0600. Placeholders only.
NODE_ENV=production
PORT=5000
HOST=127.0.0.1
DATABASE_URL=<isolated-staging-postgresql-url>
FRONTEND_URL=https://<staging-hostname>
UPLOAD_DIR=/var/lib/forgestudio/uploads

# This bundle uses one Caddy process on the same host connecting over loopback.
# "loopback" trusts only loopback proxy addresses. Re-evaluate if topology changes.
TRUST_PROXY=loopback

SMTP_HOST=<smtp-host>
SMTP_PORT=<smtp-port>
SMTP_USER=<smtp-user>
SMTP_PASSWORD=<smtp-password>
SMTP_FROM=<authorized-from-address>

GOOGLE_CLIENT_ID=<optional-staging-client-id>
GOOGLE_CLIENT_SECRET=<optional-staging-client-secret>
GITHUB_CLIENT_ID=<optional-staging-client-id>
GITHUB_CLIENT_SECRET=<optional-staging-client-secret>
