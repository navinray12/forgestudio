NODE_ENV=development

PORT=5000

FRONTEND_URL=http://localhost:5173

DATABASE_URL=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Workspace invitation delivery (required; no simulated sends)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Generate once: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Keep stable across API/worker instances; rotation requires pending unsent invitations to be resent.
WORKSPACE_INVITATION_TOKEN_KEY=

# Optional account Billing payment management (verified customer mapping also required).
# Configure payment-method updates in the Stripe customer portal. Card data stays at Stripe.
STRIPE_SECRET_KEY=

# 32 random bytes as 64 hexadecimal characters. Preserve across deployments; encrypts authenticator secrets.
SECURITY_ENCRYPTION_KEY=

# Optional Help & Support resources; HTTPS URLs without credentials. Blank means unavailable.
DASHBOARD_SUPPORT_CHAT_URL=
DASHBOARD_SUPPORT_VIDEO_URL=
# Actual business hours, including timezone; blank means hours not configured.
DASHBOARD_SUPPORT_HOURS=

# Optional dashboard notification mail worker. Uses real SMTP; keep false until configured.
DASHBOARD_NOTIFICATION_EMAIL_ENABLED=false

# Administrator-trusted native executable/PHAR paths; never supplied as browser commands.
COMPOSER_PHP_PATH=
COMPOSER_BINARY_PATH=
COMPOSER_INSTALL_ENABLED=false
