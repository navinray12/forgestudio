# Local development database; never use customer data for tests.
DATABASE_URL=postgresql://forgestudio_dev:local-development-only@127.0.0.1:55432/forgestudio_dev
PORT=5000
FRONTEND_URL=http://localhost:5173

# Optional OAuth providers. Leave blank to run without those providers.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional inbound webhook keys, provisioned separately from outbound credentials.
# JSON object: connection UUID -> independent random signing key (32+ characters).
# WordPress outbound publishing is disabled until the real connector is implemented.
WORDPRESS_WEBHOOK_SECRETS={}
