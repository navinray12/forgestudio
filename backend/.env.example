NODE_ENV=development

PORT=5000

FRONTEND_URL=http://localhost:5173

DATABASE_URL=

# Absolute persistent directory for uploaded assets in production.
# Example: C:\forgestudio-data\uploads or /var/lib/forgestudio/uploads
UPLOAD_DIR=

# Explicit Express proxy trust (for example: 1 for one reverse-proxy hop, or loopback).
# Required in production; scope this to the actual deployment topology.
TRUST_PROXY=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
