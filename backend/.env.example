NODE_ENV=development

PORT=5000

FRONTEND_URL=http://localhost:5173

DATABASE_URL=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Persistent Media & Asset Storage (Feature 7)
# Default development location: ./backend/uploads (or ./uploads relative to backend)
# In production, point UPLOAD_DIR to a mounted persistent volume/disk outside ephemeral container directories.
# Example: UPLOAD_DIR=/var/data/forgestudio/uploads or UPLOAD_DIR=/mnt/persistent_storage/uploads
# NOTE: In Docker/Kubernetes/Render/Railway, setting UPLOAD_DIR alone does not make storage persistent;
# you must mount a persistent volume (e.g. docker volume / Kubernetes PVC) to that path.
# Subdirectories automatically maintained: /images, /backups, /optimized
UPLOAD_DIR=

# Stripe Billing & Payment Configuration (Module 18)
# Staging / Test Mode: Use 'sk_test_...' and 'whsec_...'
# Production: Use 'sk_live_...' and live webhook signing secret
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
APP_URL=http://localhost:5173

# ACME / Let's Encrypt Automated SSL Configuration (Module 19)
# Set to 'true' to activate the real ACME Certificate Provider
ACME_ENABLED=false
# Environment: 'staging' (default, safe for testing) or 'production'
ACME_ENVIRONMENT=staging
# Safeguard: Production issuance is blocked unless explicitly enabled:
ALLOW_ACME_PRODUCTION=false
# Contact email for Let's Encrypt certificate notices and expiry warnings
ACME_CONTACT_EMAIL=admin@example.com
# Optional: Override ACME Directory URL (defaults to Let's Encrypt Staging or Production based on ACME_ENVIRONMENT)
# ACME_DIRECTORY_URL=https://acme-staging-v02.api.letsencrypt.org/directory
# Secure Persistent Storage for ACME account keys and domain private keys (Mode 0700/0600)
# Outside public uploads directory. Example: /var/data/forgestudio/ssl_secure
SSL_STORAGE_DIR=
# Edge Router / Ingress Configuration (Caddy / Nginx / Kubernetes)
# When true, certificates are atomically delivered to INGRESS_CERT_DIR for port 443 HTTPS serving
EDGE_INGRESS_ENABLED=false
INGRESS_CERT_DIR=
