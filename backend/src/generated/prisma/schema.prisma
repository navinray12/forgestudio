generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum VerificationMethod {
  EMAIL
  PHONE
  GITHUB
}

enum IdentityProvider {
  EMAIL
  PHONE
  GOOGLE
  GITHUB
}

enum OtpPurpose {
  PHONE_SIGNUP
  PHONE_LOGIN
  PHONE_VERIFICATION
  EMAIL_SIGNUP
  EMAIL_LOGIN
}

enum OtpChannel {
  EMAIL
  WHATSAPP
}

model User {
  id                 String              @id @default(uuid()) @db.Uuid
  fullName           String?
  email              String?             @unique
  phone              String?             @unique
  passwordHash       String?
  verificationMethod VerificationMethod?
  emailVerified      Boolean             @default(false)
  phoneVerified      Boolean             @default(false)
  status             UserStatus          @default(ACTIVE)
  role               UserRole            @default(USER)
  lastLoginAt        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  identities          Identity[]
  sessions            Session[]
  otpVerifications    OtpVerification[]
  passwordResetTokens PasswordResetToken[]
  subscription        UserSubscription?
  websites            Website[]
  collaborations      WebsiteCollaborator[]
  ownedTeams          Team[]                @relation("TeamOwner")
  teamMemberships     TeamMember[]
  sentInvitations     TeamInvitation[]      @relation("InvitationSender")
  sentWebsiteInvites  WebsiteInvitation[]   @relation("WebsiteInvitationSender")
  granularPermissions GranularPermission[]
  developerApiKeys    DeveloperApiKey[]
  customEntries       CustomEntry[]
  codeRevisions       CustomCodeRevision[]
  authoredNotes       DesignNote[]          @relation("NoteAuthor")
  resolvedNotes       DesignNote[]          @relation("NoteResolver")
  componentAccesses   ComponentAccess[]

  @@index([status])
  @@index([role])
  @@map("users")
}

model Website {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @db.Uuid
  name                String
  slug                String
  status              String   @default("DRAFT")
  editorData          Json     @default("{\"version\":1,\"elements\":[]}")
  performanceSettings Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  teamId              String?  @db.Uuid

  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  team                  Team?                 @relation(fields: [teamId], references: [id], onDelete: SetNull)
  collaborators         WebsiteCollaborator[]
  invitations           WebsiteInvitation[]
  granularPermissions   GranularPermission[]
  customPostTypes       CustomPostType[]
  customCodeSnippets    CustomCodeSnippet[]
  pluginCompatibilities PluginCompatibility[]
  designNotes           DesignNote[]
  componentAccesses     ComponentAccess[]

  @@index([userId])
  @@map("websites")
}

model WebsiteCollaborator {
  id         String   @id @default(uuid()) @db.Uuid
  websiteId  String   @db.Uuid
  userId     String   @db.Uuid
  permission String   @default("VIEWER") // "VIEWER" | "EDITOR"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([websiteId, userId])
  @@index([userId])
  @@index([websiteId])
  @@map("website_collaborators")
}

model OtpVerification {
  id         String     @id @default(uuid()) @db.Uuid
  userId     String?    @db.Uuid
  email      String?
  otpHash    String
  purpose    OtpPurpose
  channel    OtpChannel @default(EMAIL)
  attempts   Int        @default(0)
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime   @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([purpose])
  @@map("otp_verifications")
}

model Identity {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @db.Uuid
  provider       IdentityProvider
  providerUserId String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("identities")
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model SubscriptionPlan {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  slug            String   @unique
  price           Int
  currency        String   @default("INR")
  billingInterval String   @default("monthly")
  websiteLimit    Int
  storageLimitMb  Int      @default(100)
  aiCreditLimit   Int      @default(0)
  features        Json
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  subscriptions UserSubscription[]

  @@map("subscription_plans")
}

model UserSubscription {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @unique @db.Uuid
  planId             String    @db.Uuid
  status             String    @default("ACTIVE")
  currentPeriodStart DateTime  @default(now())
  currentPeriodEnd   DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan SubscriptionPlan @relation(fields: [planId], references: [id])

  @@map("user_subscriptions")
}

model Team {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?
  ownerId     String   @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner       User             @relation("TeamOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members     TeamMember[]
  websites    Website[]
  invitations TeamInvitation[]

  @@index([ownerId])
  @@map("teams")
}

model TeamMember {
  id        String   @id @default(uuid()) @db.Uuid
  teamId    String   @db.Uuid
  userId    String   @db.Uuid
  role      String   @default("DESIGNER")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
  @@map("team_members")
}

model TeamInvitation {
  id        String   @id @default(uuid()) @db.Uuid
  teamId    String   @db.Uuid
  email     String
  role      String   @default("DESIGNER")
  tokenHash String   @unique
  status    String   @default("PENDING") // PENDING, ACCEPTED, EXPIRED, CANCELLED
  expiresAt DateTime
  invitedBy String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team    Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  inviter User @relation("InvitationSender", fields: [invitedBy], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([email])
  @@map("team_invitations")
}

model WebsiteInvitation {
  id        String   @id @default(uuid()) @db.Uuid
  websiteId String   @db.Uuid
  email     String
  role      String   @default("DESIGNER")
  tokenHash String   @unique
  status    String   @default("PENDING") // PENDING, ACCEPTED, EXPIRED, CANCELLED
  expiresAt DateTime
  invitedBy String   @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  inviter User    @relation("WebsiteInvitationSender", fields: [invitedBy], references: [id], onDelete: Cascade)

  @@index([websiteId])
  @@index([email])
  @@map("website_invitations")
}

model GranularPermission {
  id         String   @id @default(uuid()) @db.Uuid
  websiteId  String   @db.Uuid
  userId     String   @db.Uuid
  resourceId String   @default("*") // "*" for global, or specific component id
  capability String // "VIEW", "COMMENT", "EDIT_CONTENT", "EDIT_DESIGN", "PUBLISH", "MANAGE_PERMISSIONS"
  effect     String // "ALLOW" or "DENY"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // A user can only have one rule per capability for a specific resource
  @@unique([websiteId, userId, resourceId, capability])
  @@index([websiteId])
  @@index([userId])
  @@map("granular_permissions")
}

model DeveloperApiKey {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  name       String
  tokenHash  String    @unique
  scopes     String[]
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("developer_api_keys")
}

model CustomPostType {
  id          String   @id @default(uuid()) @db.Uuid
  websiteId   String   @db.Uuid
  name        String
  singular    String
  plural      String
  slug        String
  description String?
  hasArchive  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  website Website       @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  fields  CustomField[]
  entries CustomEntry[]

  @@unique([websiteId, slug])
  @@index([websiteId])
  @@map("custom_post_types")
}

model CustomField {
  id         String   @id @default(uuid()) @db.Uuid
  postTypeId String   @db.Uuid
  name       String
  key        String
  type       String
  required   Boolean  @default(false)
  order      Int      @default(0)
  options    Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  postType CustomPostType @relation(fields: [postTypeId], references: [id], onDelete: Cascade)

  @@index([postTypeId])
  @@map("custom_fields")
}

model CustomEntry {
  id         String   @id @default(uuid()) @db.Uuid
  postTypeId String   @db.Uuid
  authorId   String   @db.Uuid
  title      String
  slug       String
  status     String   @default("DRAFT") // DRAFT, PUBLISHED, ARCHIVED
  values     Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  postType CustomPostType @relation(fields: [postTypeId], references: [id], onDelete: Cascade)
  author   User           @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@unique([postTypeId, slug])
  @@index([postTypeId])
  @@index([authorId])
  @@map("custom_entries")
}

model CustomCodeSnippet {
  id           String    @id @default(uuid()) @db.Uuid
  websiteId    String    @db.Uuid
  title        String
  language     String // HTML, CSS, JS
  code         String
  placement    String // HEAD, BODY_TOP, BODY_BOTTOM
  scope        String    @default("GLOBAL") // GLOBAL, PAGE
  pageId       String?
  conditions   Json? // For F-113: {"pages": [], "devices": []}
  priority     Int       @default(0) // F-116
  status       String    @default("DRAFT") // DRAFT, PUBLISHED, SCHEDULED (F-114, F-115)
  scheduledFor DateTime?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  website   Website              @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  revisions CustomCodeRevision[]

  @@index([websiteId])
  @@map("custom_code_snippets")
}

model CustomCodeRevision {
  id        String   @id @default(uuid()) @db.Uuid
  snippetId String   @db.Uuid
  code      String
  authorId  String?  @db.Uuid
  createdAt DateTime @default(now())

  snippet CustomCodeSnippet @relation(fields: [snippetId], references: [id], onDelete: Cascade)
  author  User?             @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([snippetId])
  @@map("custom_code_revisions")
}

model PluginCompatibility {
  id                  String   @id @default(uuid()) @db.Uuid
  websiteId           String   @db.Uuid
  pluginSlug          String
  currentVersion      String
  compatibilityStatus String   @default("UNKNOWN") // SUPPORTED, CONFLICT, UNKNOWN
  fallbackEnabled     Boolean  @default(false)
  issues              Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@unique([websiteId, pluginSlug])
  @@index([websiteId])
  @@map("plugin_compatibility_records")
}

model DesignNote {
  id         String    @id @default(uuid()) @db.Uuid
  websiteId  String    @db.Uuid
  elementId  String?
  authorId   String    @db.Uuid
  content    String    @db.Text
  status     String    @default("OPEN")
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  resolvedAt DateTime?
  resolvedBy String?   @db.Uuid

  website  Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  author   User    @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  resolver User?   @relation("NoteResolver", fields: [resolvedBy], references: [id], onDelete: SetNull)

  @@index([websiteId])
  @@index([authorId])
  @@index([elementId])
  @@map("design_notes")
}

model ComponentAccess {
  id          String   @id @default(uuid()) @db.Uuid
  websiteId   String   @db.Uuid
  componentId String
  userId      String?  @db.Uuid
  roleId      String?
  permission  String   @default("EDIT")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([websiteId])
  @@index([componentId])
  @@map("component_access")
}
