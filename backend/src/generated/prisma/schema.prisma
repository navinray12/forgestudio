  role      String   @default("DESIGNER") @db.VarChar(50)
  tokenHash String   @unique @db.VarChar(255)
  status    String   @default("PENDING") @db.VarChar(50) // PENDING, ACCEPTED, REJECTED, EXPIRED
  expiresAt DateTime @db.Timestamptz(6)
  invitedBy String   @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  inviter User    @relation("WebsiteInvitedBy", fields: [invitedBy], references: [id], onDelete: Cascade)

