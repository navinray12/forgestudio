generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                           String                   @id @default(uuid()) @db.Uuid
  fullName                     String?
  email                        String?                  @unique
  phone                        String?                  @unique
  passwordHash                 String?
  verificationMethod           VerificationMethod?
  emailVerified                Boolean                  @default(false)
  phoneVerified                Boolean                  @default(false)
  status                       UserStatus               @default(ACTIVE)
  role                         UserRole                 @default(USER)
  lastLoginAt                  DateTime?
  createdAt                    DateTime                 @default(now())
  updatedAt                    DateTime                 @updatedAt
  identities                   Identity[]
  otpVerifications             OtpVerification[]
  passwordResetTokens          PasswordResetToken[]
  sessions                     Session[]
  templates                    templates[]
  subscription                 UserSubscription?
  websites                     Website[]
  codeRevisions                CustomCodeRevision[]
  auditLogs                    AuditLog[]
  developerApiKeys             DeveloperApiKey[]
  designNotes                  DesignNote[]
  collaborations               WebsiteCollaborator[]
  componentAccesses            ComponentAccess[]
  customEntries                CustomEntry[]
  websiteRevisions             WebsiteRevision[]
  deployments                  Deployment[]
  wpConnections                WordPressConnection[]
  ownedTeams                   Team[]                   @relation("TeamOwner")
  teamMemberships              TeamMember[]
  sentTeamInvitations          TeamInvitation[]         @relation("TeamInvitedBy")
  sentWebsiteInvitations       WebsiteInvitation[]      @relation("WebsiteInvitedBy")
  granularPermissions          GranularPermission[]
  ownedWorkspaces              Workspace[]
  ownedOrganizations           Organization[]           @relation("OrgOwner")
  organizationMemberships      OrganizationMember[]
  workspaceMemberships         WorkspaceMember[]
  sentWorkspaceInvitations     WorkspaceInvitation[]    @relation("WorkspaceInvitedBy")
  acceptedWorkspaceInvitations WorkspaceInvitation[]    @relation("WorkspaceInvitationAccepted")
  supportGrantsReceived        SupportGrant[]           @relation("SupportGrantGrantee")
  supportGrantsApproved        SupportGrant[]           @relation("SupportGrantApprover")
  approvalRequests             PublishApprovalRequest[] @relation("ApprovalRequester")
  reviewedApprovals            PublishApprovalRequest[] @relation("ApprovalReviewer")
  draftSaveReceipts            DraftSaveReceipt[]

  @@index([status])
  @@index([role])
  @@map("users")
}

model Website {
  id                      String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                  String                   @db.Uuid
  name                    String                   @db.VarChar(255)
  slug                    String                   @db.VarChar(255)
  status                  String                   @default("DRAFT") @db.VarChar(50)
  editorData              Json                     @default("{\"version\": 1, \"elements\": []}")
  performanceSettings     Json?                    @default("{}")
  createdAt               DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime                 @default(now()) @updatedAt @db.Timestamptz(6)
  user                    User                     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  customCodeSnippets      CustomCodeSnippet[]
  formSubmissions         FormSubmission[]
  customPostTypes         CustomPostType[]
  themeLocationRules      ThemeLocationRule[]
  sftpConnections         SftpConnection[]
  pluginIntegrations      PluginIntegration[]
  designNotes             DesignNote[]
  componentAccesses       ComponentAccess[]
  collaborators           WebsiteCollaborator[]
  revisions               WebsiteRevision[]
  deployments             Deployment[]
  wpConnection            WordPressConnection?
  wpPageMappings          WordPressPageMapping[]
  granularPermissions     GranularPermission[]
  invitations             WebsiteInvitation[]
  // Deprecated: superseded by workspaceId (FS-040 consolidated account -> workspace -> site authority).
  // Retained read-only for historical rows; no longer written by current code.
  teamId                  String?                  @db.Uuid
  team                    Team?                    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  // Authoritative tenant scope. Every site belongs to exactly one workspace; a personal
  // workspace is created automatically for users who do not choose one explicitly.
  workspaceId             String?                  @db.Uuid
  // NoAction (not Restrict) at the Prisma level: the actual SQL constraint is created
  // DEFERRABLE INITIALLY DEFERRED so it is checked at transaction commit, after a
  // same-transaction cascade (e.g. deleting a workspace's owning user, which cascades
  // to both this site's row and the workspace's row) has finished rather than mid-cascade.
  workspace               Workspace?               @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  // Deprecated: the account boundary is reached via workspace.organizationId, not a direct link.
  // Retained read-only for historical rows; no longer written by current code.
  organizationId          String?                  @db.Uuid
  organization            Organization?            @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  approvalWorkflowEnabled Boolean                  @default(false)
  approvalRequests        PublishApprovalRequest[]
  draftRevision           String                   @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  draftSaveReceipts       DraftSaveReceipt[]

  @@index([userId], map: "idx_websites_user_id")
  @@index([organizationId])
  @@map("websites")
}

model DraftSaveReceipt {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  websiteId        String   @db.Uuid
  actorId          String   @db.Uuid
  mutationId       String   @db.VarChar(128)
  requestHash      String   @db.VarChar(64)
  acceptedRevision String   @db.Uuid
  documentHash     String   @db.VarChar(64)
  document         Json
  acceptedAt       DateTime @default(now()) @db.Timestamptz(6)
  expiresAt        DateTime @default(dbgenerated("(CURRENT_TIMESTAMP + '7 days'::interval)")) @db.Timestamptz(6)
  website          Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  actor            User     @relation(fields: [actorId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([websiteId, actorId, mutationId], map: "draft_save_receipts_scope_key")
  @@index([expiresAt], map: "draft_save_receipts_expiry_idx")
  @@index([websiteId, acceptedAt, id], map: "draft_save_receipts_history_idx")
  @@map("draft_save_receipts")
}

model OtpVerification {
  id         String      @id @default(uuid()) @db.Uuid
  userId     String?     @db.Uuid
  email      String?
  otpHash    String
  purpose    OtpPurpose
  channel    OtpChannel? @default(EMAIL)
  attempts   Int         @default(0)
  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime    @default(now())
  user       User?       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([purpose])
  @@map("otp_verifications")
}

model Identity {
  id             String           @id @default(uuid()) @db.Uuid
  userId         String           @db.Uuid
  provider       IdentityProvider
  providerUserId String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("identities")
}

model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model SubscriptionPlan {
  id              String             @id @default(uuid()) @db.Uuid
  name            String
  slug            String             @unique
  price           Int
  currency        String             @default("INR")
  billingInterval String             @default("monthly")
  websiteLimit    Int
  storageLimitMb  Int                @default(100)
  aiCreditLimit   Int                @default(0)
  features        Json
  isActive        Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  subscriptions   UserSubscription[]

  @@map("subscription_plans")
}

model UserSubscription {
  id                 String           @id @default(uuid()) @db.Uuid
  userId             String           @unique @db.Uuid
  planId             String           @db.Uuid
  status             String           @default("ACTIVE")
  currentPeriodStart DateTime         @default(now())
  currentPeriodEnd   DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  plan               SubscriptionPlan @relation(fields: [planId], references: [id])
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_subscriptions")
}

model templates {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @db.Uuid
  name         String   @db.VarChar(255)
  description  String?
  type         String   @default("PAGE") @db.VarChar(50)
  templateData Json     @default("{\"elements\": [], \"pageSettings\": {}}")
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @db.Timestamptz(6)
  category     String   @default("Other") @db.VarChar(100)
  isFavorite   Boolean  @default(false)
  isShared     Boolean  @default(false)
  shareToken   String?  @db.VarChar(255)
  users        User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([shareToken], map: "idx_templates_share_token")
  @@index([userId], map: "idx_templates_user_id")
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum VerificationMethod {
  EMAIL
  PHONE
  GITHUB
}

enum IdentityProvider {
  EMAIL
  PHONE
  GOOGLE
  GITHUB
}

enum OtpPurpose {
  PHONE_SIGNUP
  PHONE_LOGIN
  PHONE_VERIFICATION
  EMAIL_SIGNUP
  EMAIL_LOGIN
}

enum OtpChannel {
  EMAIL
  WHATSAPP
}

model CustomCodeSnippet {
  id           String    @id @default(uuid()) @db.Uuid
  websiteId    String    @db.Uuid
  name         String?
  title        String?
  language     String    @default("JS") // JS, CSS, HTML
  codeType     String    @default("JS") // JS, CSS, HTML
  code         String
  placement    String    @default("HEAD") // HEAD, BODY_TOP, BODY_BOTTOM, BODY_START, BODY_END
  location     String    @default("HEAD")
  scope        String    @default("GLOBAL") // GLOBAL, PAGE
  pageId       String?
  conditions   Json?     @default("[]")
  priority     Int       @default(10)
  status       String    @default("PUBLISHED") // DRAFT, PUBLISHED, SCHEDULED
  scheduledFor DateTime?
  isEnabled    Boolean   @default(true)
  isActive     Boolean   @default(true)
  isDraft      Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  website   Website              @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  revisions CustomCodeRevision[]

  @@index([websiteId])
  @@map("custom_code_snippets")
}

model CustomCodeRevision {
  id        String   @id @default(uuid()) @db.Uuid
  snippetId String   @db.Uuid
  code      String
  authorId  String?  @db.Uuid
  createdAt DateTime @default(now())

  snippet CustomCodeSnippet @relation(fields: [snippetId], references: [id], onDelete: Cascade)
  author  User?             @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([snippetId])
  @@map("custom_code_revisions")
}

model FormSubmission {
  id        String   @id @default(uuid()) @db.Uuid
  websiteId String   @db.Uuid
  formId    String
  formName  String?  @default("Contact Form") @db.VarChar(255)
  data      Json
  metadata  Json?    @default("{}")
  ipAddress String?
  status    String   @default("NEW")
  createdAt DateTime @default(now())

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId])
  @@index([formId])
  @@map("form_submissions")
}

model CustomPostType {
  id          String   @id @default(uuid()) @db.Uuid
  websiteId   String   @db.Uuid
  name        String
  slug        String
  description String?
  supports    Json     @default("[\"title\", \"editor\", \"thumbnail\"]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  website Website       @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  fields  CustomField[]
  entries CustomEntry[]

  @@unique([websiteId, slug])
  @@map("custom_post_types")
}

model ThemeLocationRule {
  id           String   @id @default(uuid()) @db.Uuid
  websiteId    String   @db.Uuid
  locationType String // HEADER, FOOTER, SINGLE, ARCHIVE, ERROR404
  templateId   String
  conditions   Json     @default("[]")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([websiteId, locationType])
  @@map("theme_location_rules")
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String?  @db.Uuid
  action         String
  targetResource String
  details        Json?
  ipAddress      String?
  createdAt      DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@map("audit_logs")
}

model SftpConnection {
  id         String   @id @default(uuid()) @db.Uuid
  websiteId  String   @db.Uuid
  host       String
  port       Int      @default(22)
  username   String
  remotePath String   @default("/var/www/html")
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@map("sftp_connections")
}

model PluginIntegration {
  id         String   @id @default(uuid()) @db.Uuid
  websiteId  String   @db.Uuid
  pluginSlug String // acf, toolset, pods, learndash, lifterlms
  config     Json     @default("{}")
  isEnabled  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@unique([websiteId, pluginSlug])
  @@map("plugin_integrations")
}

model MultisiteNetwork {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  domain      String   @unique
  networkType String   @default("SUBDIRECTORY") // SUBDIRECTORY | SUBDOMAIN
  config      Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("multisite_networks")
}

model CustomField {
  id         String   @id @default(uuid()) @db.Uuid
  postTypeId String   @db.Uuid
  name       String
  slug       String
  type       String   @default("text")
  order      Int      @default(0)
  config     Json     @default("{}")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  postType CustomPostType @relation(fields: [postTypeId], references: [id], onDelete: Cascade)

  @@map("custom_fields")
}

model CustomEntry {
  id         String   @id @default(uuid()) @db.Uuid
  postTypeId String   @db.Uuid
  title      String
  slug       String?
  data       Json     @default("{}")
  status     String   @default("PUBLISHED")
  authorId   String?  @db.Uuid
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  postType CustomPostType @relation(fields: [postTypeId], references: [id], onDelete: Cascade)
  author   User?          @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@map("custom_entries")
}

model DesignNote {
  id        String   @id @default(uuid()) @db.Uuid
  websiteId String   @db.Uuid
  elementId String?
  authorId  String   @db.Uuid
  content   String
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("design_notes")
}

model PluginCompatibility {
  id                  String   @id @default(uuid()) @db.Uuid
  name                String
  slug                String   @unique
  category            String?
  compatibilityStatus String   @default("SUPPORTED")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("plugin_compatibilities")
}

model DeveloperApiKey {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  name       String
  tokenHash  String    @unique
  scopes     Json      @default("[\"websites:read\"]")
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("developer_api_keys")
}

model ComponentAccess {
  id          String   @id @default(uuid()) @db.Uuid
  websiteId   String   @db.Uuid
  componentId String
  elementId   String   @default("")
  userId      String?  @db.Uuid
  permission  String   @default("VIEW")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([websiteId, componentId])
  @@map("component_accesses")
}

model WebsiteCollaborator {
  id         String   @id @default(uuid()) @db.Uuid
  websiteId  String   @db.Uuid
  userId     String   @db.Uuid
  permission String   @default("EDITOR")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([websiteId, userId])
  @@map("website_collaborators")
}

model WebsiteKit {
  id           String   @id @default(uuid()) @db.Uuid
  slug         String   @unique @db.VarChar(255)
  name         String   @db.VarChar(255)
  category     String   @db.VarChar(100)
  description  String?
  thumbnail    String?
  previewUrl   String?
  pageCount    Int      @default(1)
  tags         Json     @default("[]")
  globalStyles Json     @default("{}")
  pages        Json     @default("[]")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([category])
  @@index([isActive])
  @@map("website_kits")
}

model WebsiteRevision {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  websiteId    String   @db.Uuid
  version      Int
  revisionType String   @default("MANUAL") @db.VarChar(50) // MANUAL, PUBLISH, CHECKPOINT, RESTORE
  description  String?  @db.VarChar(500)
  data         Json
  createdBy    String?  @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(6)

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  creator User?   @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@unique([websiteId, version])
  @@index([websiteId])
  @@index([websiteId, createdAt])
  @@map("website_revisions")
}

model Deployment {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  websiteId        String    @db.Uuid
  version          Int
  status           String    @default("QUEUED") @db.VarChar(50) // QUEUED, VALIDATING, BUILDING, PROCESSING, DEPLOYING, VERIFYING, PUBLISHED, RECONCILIATION_REQUIRED, VALIDATION_FAILED, BUILD_FAILED, DEPLOY_FAILED, VERIFICATION_FAILED
  environment      String    @default("PRODUCTION") @db.VarChar(50) // PRODUCTION, STAGING, DEVELOPMENT
  destinationType  String    @default("INTERNAL") @db.VarChar(50) // INTERNAL, WORDPRESS, STATIC
  destinationRef   String?   @db.VarChar(500)
  sourceRevisionId String?   @db.Uuid
  metadata         Json?     @default("{}")
  error            Json?
  startedAt        DateTime  @default(now()) @db.Timestamptz(6)
  completedAt      DateTime? @db.Timestamptz(6)
  createdBy        String?   @db.Uuid
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  creator User?   @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([websiteId])
  @@index([websiteId, createdAt])
  @@index([status])
  @@map("deployments")
}

model WordPressConnection {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String    @db.Uuid
  websiteId      String    @unique @db.Uuid
  siteUrl        String    @db.VarChar(500)
  status         String    @default("CONNECTED") @db.VarChar(50) // CONNECTED, DISCONNECTED, ERROR
  wpSiteName     String?   @db.VarChar(255)
  apiKeyHash     String    @db.VarChar(255)
  capabilities   Json?     @default("[]")
  metadata       Json?     @default("{}")
  lastVerifiedAt DateTime? @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  website         Website                   @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  user            User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  webhookReceipts WordPressWebhookReceipt[]

  @@unique([id, websiteId])
  @@index([userId])
  @@map("wordpress_connections")
}

// Durable inbound events. Receipt acknowledgement precedes asynchronous effects.
model WordPressWebhookReceipt {
  id            String              @id @default(uuid()) @db.Uuid
  connectionId  String              @db.Uuid
  websiteId     String              @db.Uuid
  eventId       String              @db.VarChar(128)
  event         String              @db.VarChar(40)
  payload       Json
  payloadHash   String              @db.VarChar(64)
  status        String              @default("PENDING") @db.VarChar(20)
  attempts      Int                 @default(0)
  nextAttemptAt DateTime            @default(now())
  lastError     String?
  createdAt     DateTime            @default(now())
  processedAt   DateTime?
  connection    WordPressConnection @relation(fields: [connectionId, websiteId], references: [id, websiteId], onDelete: Cascade)

  @@unique([connectionId, eventId])
  @@index([status, nextAttemptAt])
  @@map("wordpress_webhook_receipts")
}

model WordPressPageMapping {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  websiteId    String   @db.Uuid
  forgePageId  String   @db.VarChar(100)
  wpPostId     Int
  wpPostSlug   String?  @db.VarChar(255)
  wpPostUrl    String?  @db.VarChar(500)
  lastSyncedAt DateTime @default(now()) @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@unique([websiteId, forgePageId])
  @@index([websiteId])
  @@map("wordpress_page_mappings")
}

model GranularPermission {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  websiteId  String   @db.Uuid
  userId     String   @db.Uuid
  resourceId String   @default("*") @db.VarChar(100)
  capability String   @db.VarChar(100)
  effect     String   @default("ALLOW") @db.VarChar(20) // ALLOW, DENY
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([websiteId, userId, resourceId, capability])
  @@index([websiteId])
  @@index([userId])
  @@map("granular_permissions")
}

model Team {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @db.VarChar(255)
  description String?  @db.VarChar(500)
  ownerId     String   @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  owner       User             @relation("TeamOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members     TeamMember[]
  websites    Website[]
  invitations TeamInvitation[]

  @@index([ownerId])
  @@map("teams")
}

model TeamMember {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  teamId    String   @db.Uuid
  userId    String   @db.Uuid
  role      String   @default("DESIGNER") @db.VarChar(50) // OWNER, ADMIN, DESIGNER, CONTENT_EDITOR, REVIEWER
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
  @@map("team_members")
}

