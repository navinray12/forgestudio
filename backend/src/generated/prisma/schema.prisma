model Workspace {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String?  @db.Uuid
  name           String   @db.VarChar(255)
  slug           String   @unique @db.VarChar(255)
  ownerId        String   @db.Uuid
  // A workspace created implicitly for a single user (e.g. on first website creation)
  // rather than explicitly by a collaboration decision. Personal workspaces still
  // enforce the same membership/authorization path as any other workspace.
  isPersonal     Boolean  @default(false)
  settings       Json?    @default("{}")
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  organization  Organization?         @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  owner         User                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members       WorkspaceMember[]
  invitations   WorkspaceInvitation[]
  supportGrants SupportGrant[]
  websites      Website[]

  @@index([ownerId])
  @@index([organizationId])
  @@map("workspaces")
}

model Organization {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.VarChar(255)
  slug      String   @unique @db.VarChar(255)
  ownerId   String   @db.Uuid
  settings  Json?    @default("{}")
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  owner      User                 @relation("OrgOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members    OrganizationMember[]
  workspaces Workspace[]
  websites   Website[]

  @@index([ownerId])
  @@map("organizations")
}

model OrganizationMember {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  userId         String   @db.Uuid
  role           String   @default("MEMBER") @db.VarChar(50) // OWNER, ADMIN, MEMBER
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

model WorkspaceMember {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId   String   @db.Uuid
  userId        String   @db.Uuid
  role          String   @default("MEMBER") @db.VarChar(50) // OWNER, ADMIN, MEMBER
  // ACTIVE grants access; REVOKED preserves history without granting it. Revocation
  // is a status change, never a delete, so audit/history and in-flight checks observe it.
  status        String   @default("ACTIVE") @db.VarChar(20) // ACTIVE, REVOKED
  // Bumped on every role/status change. Lets a long-lived permission decision detect
  // that the membership it was based on has since changed (policy-generation guard).
  policyVersion Int      @default(1)
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId, status])
  @@map("workspace_members")
}

// Single-use, bound-recipient workspace invitation (blueprint SS12.5): the recipient
// email, role and expiry are fixed at issue time; accepting is a guarded one-time
// status transition so a reused or raced token cannot grant membership twice.
model WorkspaceInvitation {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String   @db.Uuid
  email       String   @db.VarChar(255)
  role        String   @default("MEMBER") @db.VarChar(50) // ADMIN, MEMBER
  tokenHash   String   @unique @db.VarChar(255)
  status      String   @default("PENDING") @db.VarChar(20) // PENDING, ACCEPTED, REVOKED, EXPIRED
  expiresAt   DateTime @db.Timestamptz(6)
  invitedBy   String   @db.Uuid
  acceptedBy  String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  inviter   User      @relation("WorkspaceInvitedBy", fields: [invitedBy], references: [id], onDelete: Cascade, onUpdate: Cascade)
  accepter  User?     @relation("WorkspaceInvitationAccepted", fields: [acceptedBy], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([workspaceId])
  @@index([email])
  @@map("workspace_invitations")
}

// Time-limited, workspace-scoped elevation for platform support/staff access
// (blueprint SS12.3). Access is granted only while a grant exists that is neither
// expired nor revoked; there is no ambient "support" role that bypasses this.
model SupportGrant {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String    @db.Uuid
  granteeId   String    @db.Uuid
  reason      String    @db.VarChar(500)
  approvedBy  String?   @db.Uuid
  expiresAt   DateTime  @db.Timestamptz(6)
  revokedAt   DateTime? @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  grantee   User      @relation("SupportGrantGrantee", fields: [granteeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  approver  User?     @relation("SupportGrantApprover", fields: [approvedBy], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([workspaceId, granteeId, expiresAt])
  @@map("support_grants")
}

model PublishApprovalRequest {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  websiteId     String    @db.Uuid
  requesterId   String    @db.Uuid
  reviewerId    String?   @db.Uuid
  status        String    @default("PENDING") @db.VarChar(50) // PENDING, APPROVED, REJECTED, CANCELLED
  targetVersion Int
  reviewNotes   String?   @db.VarChar(1000)
  snapshot      Json
  reviewedAt    DateTime? @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  website   Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  requester User    @relation("ApprovalRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  reviewer  User?   @relation("ApprovalReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([websiteId])
  @@index([requesterId])
  @@index([status])
  @@map("publish_approval_requests")
}

model BackgroundJob {
  id          String    @id @default(uuid()) @db.Uuid
  type        String    @db.VarChar(100)
  payload     Json      @default("{}")
  status      String    @default("QUEUED") @db.VarChar(50) // QUEUED, RUNNING, COMPLETED, FAILED, CANCELLED
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  lastError   String?   @db.VarChar(2000)
  runAt       DateTime  @default(now()) @db.Timestamptz(6)
  startedAt   DateTime? @db.Timestamptz(6)
  completedAt DateTime? @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([status, runAt])
  @@index([type])
  @@map("background_jobs")
}
