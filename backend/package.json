    "dev": "tsx watch src/server.ts",
    "build": "tsc && node -e \"fs.cpSync('src/generated', 'dist/generated', { recursive: true })\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --root .. --project backend",
    "test:url": "tsx src/tests/url-system.test.ts",
    "start": "node dist/server.js",
    "dev:worker": "tsx watch src/workers/background-worker.ts",
    "start:worker": "node dist/workers/background-worker.js",
    "test:master": "tsx tests/master.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:seed": "tsx prisma/seed.ts",
    "seed:templates": "tsx src/scripts/seed-templates/index.ts"
  },
  "keywords": [],
